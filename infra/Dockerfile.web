# Образ сайта (Next.js). Адрес API зашивается в прокси /api/v1/* при сборке.
FROM node:22-alpine AS build
WORKDIR /app
COPY package.json package-lock.json ./
COPY apps/web/package.json apps/web/
COPY packages/api-client packages/api-client
RUN npm ci --no-audit --no-fund
COPY apps/web apps/web
ARG OLYMP_API_URL=http://api:8000
ENV OLYMP_API_URL=$OLYMP_API_URL NEXT_TELEMETRY_DISABLED=1
RUN npm run build --workspace olymp-web

FROM node:22-alpine
WORKDIR /app
ENV NODE_ENV=production NEXT_TELEMETRY_DISABLED=1
COPY --from=build /app /app
USER node
EXPOSE 3000
HEALTHCHECK --interval=15s --timeout=4s CMD wget -q -O /dev/null http://127.0.0.1:3000/ || exit 1
CMD ["npm", "run", "start", "--workspace", "olymp-web"]
