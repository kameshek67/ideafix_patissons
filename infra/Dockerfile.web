# Образ сайта (Next.js). Адрес API зашивается в прокси /api/v1/* при сборке, а поток помощника
# читает его при запуске, поэтому переменная нужна на обоих этапах.
FROM node:22-alpine AS build
# сборке нужны dev-зависимости (tailwind, postcss) и запись в /app, даже если локальный тег образа
# подменён чужим (NODE_ENV=production, USER node)
USER root
WORKDIR /app
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci --include=dev --no-audit --no-fund
COPY frontend ./
ARG OLYMP_API_URL=http://api:8000
ENV OLYMP_API_URL=$OLYMP_API_URL NEXT_TELEMETRY_DISABLED=1
RUN npm run build

FROM node:22-alpine
WORKDIR /app
ARG OLYMP_API_URL=http://api:8000
ENV NODE_ENV=production NEXT_TELEMETRY_DISABLED=1 OLYMP_API_URL=$OLYMP_API_URL
COPY --from=build /app /app
USER node
EXPOSE 3000
HEALTHCHECK --interval=15s --timeout=4s --start-period=60s --start-interval=2s CMD wget -q -O /dev/null http://127.0.0.1:3000/ || exit 1
CMD ["npm", "run", "start"]
