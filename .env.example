# Локальные значения для разработки (скопируйте в .env). Секретов здесь нет и быть не должно.
OLYMP_ENV=local
OLYMP_DATABASE_URL=postgresql+psycopg://olymp:olymp@localhost:5432/olymp
OLYMP_REDIS_URL=redis://localhost:6379/0
OLYMP_RABBITMQ_URL=amqp://olymp:olymp@localhost:5672/
# адрес API, на который сайт (Next.js) проксирует /api/v1/* и ходит чат
OLYMP_API_URL=http://127.0.0.1:8000
OLYMP_ADMISSION_YEAR=2027
OLYMP_LOG_LEVEL=INFO
# каталог данных рядом с репозиторием; команды just запускаются из корня
OLYMP_DATA_DIR=data
# исходная таблица для сборки базы
XLSX_PATH=data/Olimpiady_BVI_100ballov.xlsx
# кэш адресов документов вузов
SOURCES_CACHE=data/university_documents.json

# ---- база, кэш и ограничения ----
# потолок одного запроса к БД, мс: долгий запрос становится ошибкой 503
OLYMP_DB_STATEMENT_TIMEOUT_MS=15000
# потолок ожидания блокировки в БД, мс
OLYMP_DB_LOCK_TIMEOUT_MS=3000
# время жизни ответов поиска в Redis, с
OLYMP_CACHE_TTL=600
# окно ограничения запросов к API, с
OLYMP_RATE_LIMIT_WINDOW=60
# число запросов к API с одного адреса за окно; 0 — без лимита
OLYMP_RATE_LIMIT_REQUESTS=600
# сообщений помощника с одного пользователя в минуту и в сутки
OLYMP_ASSISTANT_RATE_PER_MINUTE=10
OLYMP_ASSISTANT_RATE_PER_DAY=100
# ключ подписи контекста диалога; секрет, пусто — ключ на процесс
OLYMP_ASSISTANT_CONTEXT_SECRET=
# новых ссылок «Поделиться» с адреса в минуту и за сутки
OLYMP_SHARE_RATE_LIMIT=60
OLYMP_SHARE_DAILY_LIMIT=20000
# жалоб «не совпадает с документом» с посетителя в час и за сутки
OLYMP_REPORT_RATE_LIMIT=5
OLYMP_REPORT_DAILY_LIMIT=500
# сколько дней живёт ссылка «Поделиться» после последнего открытия
OLYMP_SHARE_TTL_DAYS=90
# адрес администратора для тестов с базой
OLYMP_TEST_DATABASE_URL=postgresql+psycopg://olymp:olymp@localhost:5432/olymp
# 1 — тесты без базы падают, 0 — база необязательна
OLYMP_REQUIRE_DB=0

# ---- мини-приложение MAX (docs/operations.md, раздел «Бот MAX») ----
# токен бота: business.max.ru → Чат-боты → бот → ⋮ → Настройки → токен.
# Это секрет: держите его только в .env (файл не попадает в git).
OLYMP_MAX_BOT_TOKEN=
# публичное имя бота без @ — для ссылок https://max.ru/<имя>?startapp=diplomas
OLYMP_MAX_BOT_NAME=
# адрес сайта для кнопки «Сайт» в сообщениях бота (по умолчанию https://ideafix.patissons.tech)
OLYMP_SITE_URL=
# дежурные оператора: id пользователей MAX через запятую. Им бот присылает жалобы «не совпадает
# с документом» и отвечает на /reports, /stats, /health; пусто — режим оператора выключен
OLYMP_MAX_OPERATOR_IDS=
# срок действия данных запуска мини-приложения, с
OLYMP_MAX_INIT_DATA_TTL=86400
# каталог корневых сертификатов Минцифры; в compose — /certs
OLYMP_MAX_CA_DIR=infra/certs
# домен для профиля https (свой сервер): docker compose --profile https up -d
OLYMP_DOMAIN=
# порты Docker-стека, если 8080/8000 заняты
OLYMP_WEB_PORT=8080
OLYMP_API_PORT=8000

# ---- помощник (без адреса, ключа и названия выключен) ----
# быстро выключить помощника, например во время демо: false
OLYMP_LLM_ENABLED=true
# адрес OpenAI-совместимого API
OLYMP_LLM_BASE_URL=https://openrouter.ai/api/v1
# ключ провайдера — секрет, держите только в .env
OLYMP_LLM_API_KEY=
# название для чата; пусто — помощник выключен
OLYMP_LLM_MODEL=
# запасной вариант на случай ошибки основного
OLYMP_LLM_FALLBACK_MODEL=
# отдельный вариант для сверки строк с документами вузов; пусто — общий
OLYMP_PARSER_MODEL=
# таймаут запроса к провайдеру, с
OLYMP_LLM_TIMEOUT=30
# предел длины ответа в токенах
OLYMP_LLM_MAX_TOKENS=1500
# гибкость ответа: 0.2 — почти без выдумок
OLYMP_LLM_TEMPERATURE=0.2
# порог выборки; 1 — без ограничения провайдера
OLYMP_LLM_TOP_P=1
# не отправлять запросы провайдерам, которые хранят данные
OLYMP_LLM_DENY_DATA_COLLECTION=true
# обращений к провайдеру в сутки на весь сервис; 0 — без ограничения
OLYMP_LLM_DAILY_REQUESTS=45
# JSON с профилями провайдеров для just assistant-eval; внутри — ключи, не хранить в git
OLYMP_LLM_PROFILES={}

# ---- разбор новых документов (docs/operations.md, «Разбор новых документов») ----
# токен оператора для /v1/ops/*: любая длинная случайная строка (openssl rand -hex 32).
# Пусто — эндпоинты отвечают 404. Секрет: только в .env
OLYMP_OPS_TOKEN=
# куда слать JSON «задача готова к проверке или не удалась»; пусто — не слать
OLYMP_OPS_WEBHOOK_URL=
# раз в сколько дней заново скачивать источники и сравнивать sha256; по умолчанию 7
OLYMP_SOURCES_RECHECK_DAYS=7
