# Локальные значения для разработки (скопируйте в .env). Секретов здесь нет и быть не должно.
OLYMP_ENV=local
OLYMP_DATABASE_URL=postgresql+psycopg://olymp:olymp@localhost:5432/olymp
OLYMP_REDIS_URL=redis://localhost:6379/0
OLYMP_RABBITMQ_URL=amqp://olymp:olymp@localhost:5672/
# адрес API, на который сайт (Next.js) проксирует /api/v1/*
OLYMP_API_URL=http://127.0.0.1:8000
PYTHONUTF8=1
