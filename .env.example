# Локальные значения для разработки (скопируйте в .env). Секретов здесь нет и быть не должно.
OLYMP_ENV=local
OLYMP_DATABASE_URL=postgresql+psycopg://olymp:olymp@localhost:5432/olymp
OLYMP_REDIS_URL=redis://localhost:6379/0
OLYMP_RABBITMQ_URL=amqp://olymp:olymp@localhost:5672/
# адрес API, на который сайт (Next.js) проксирует /api/v1/*
OLYMP_API_URL=http://127.0.0.1:8000
PYTHONUTF8=1

# ---- мини-приложение MAX (README, раздел «Мини-приложение в MAX») ----
# токен бота: business.max.ru → Чат-боты → бот → ⋮ → Настройки → токен.
# Это секрет: держите его только в .env (файл не попадает в git).
OLYMP_MAX_BOT_TOKEN=
# публичное имя бота без @ — для ссылок https://max.ru/<имя>?startapp=diplomas
OLYMP_MAX_BOT_NAME=
# адрес сайта для кнопки «Сайт» в сообщениях бота (по умолчанию https://ideafix.patissons.tech)
OLYMP_SITE_URL=
# домен для профиля https (свой сервер): docker compose --profile https up -d
OLYMP_DOMAIN=
# порты Docker-стека, если 8080/8000 заняты
# OLYMP_WEB_PORT=18080
# OLYMP_API_PORT=18000
